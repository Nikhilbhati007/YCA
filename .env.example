# Supabase Project Configuration
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy the Project URL and Anon Public Key below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Razorpay Payment Gateway Configuration (Optional - Sandbox fallback active if omitted)
# Get keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# YCA Academy UPI Configuration
NEXT_PUBLIC_ACADEMY_UPI_ID=7709705181@upi
NEXT_PUBLIC_ACADEMY_NAME="Yadav Cricket Academy & Pace Foundation"
